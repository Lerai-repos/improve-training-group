{
  "name": "base-starter-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "[ -d .claude/.git ] || (rm -rf .claude && git clone --quiet git@github.com:Lerai-repos/Claude-settings.git .claude) || true",
    "prepare": "husky",
    "dev": "doppler run -- next dev --turbo",
    "dev:local": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "pnpm dlx rimraf node_modules pnpm-lock.yaml .next",
    "ui:add": "pnpm dlx shadcn@latest add",
    "test": "pnpm exec playwright test",
    "test:e2e": "pnpm exec playwright test --project=e2e",
    "test:routes": "pnpm exec playwright test --project=routes",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "snapshot:airtable": "tsx scripts/snapshot-airtable.ts",
    "snapshot:monday": "tsx scripts/snapshot-monday.ts",
    "audit:mapping": "tsx scripts/audit-mapping.ts",
    "groups:list": "tsx scripts/trainer-groups.ts",
    "columns:list": "tsx scripts/list-columns.ts",
    "webhook:list": "tsx scripts/webhook-register.ts list",
    "webhook:register": "tsx scripts/webhook-register.ts register",
    "webhook:delete": "tsx scripts/webhook-register.ts delete",
    "preflight": "tsx scripts/preflight.ts",
    "recommend:once": "tsx scripts/recommend-once.ts",
    "recommend:enqueue": "tsx scripts/recommend-enqueue.ts",
    "recommend:parity": "tsx scripts/recommend-parity.ts",
    "google:consent": "tsx scripts/google-consent.ts",
    "eval:dryrun": "tsx scripts/eval-dryrun.ts",
    "eval:probe": "tsx scripts/eval-probe.ts",
    "fixtures:eval": "tsx scripts/extract-eval-fixtures.ts",
    "replay:verify": "tsx scripts/replay-verify.ts",
    "parity": "tsx scripts/parity-check.ts",
    "view:smoke": "tsx scripts/view-smoke.ts",
    "instellingen:create": "tsx scripts/instellingen-create.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.72",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.200.0",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@upstash/qstash": "^2.11.3",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^1.3.1",
    "@vercel/functions": "^2.0.0",
    "@vercel/otel": "^1.12.0",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^16.4.5",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^11.3.19",
    "geist": "^1.3.1",
    "jose": "^6.2.8",
    "lucide-react": "^0.446.0",
    "monday-sdk-js": "^0.5.9",
    "nanoid": "^5.0.8",
    "next": "15.5.7",
    "next-themes": "^0.3.0",
    "orderedmap": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sonner": "^1.5.0",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.0",
    "zod": "^3.25.68"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "husky": "^9.1.7",
    "jsdom": "^26",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.12.3"
}
