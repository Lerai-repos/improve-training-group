NODE_ENV=development

# OpenApi
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=	

# Logging
LOG_ENABLED=true
LOG_LEVEL=info

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for keyed travel-cache keys & audit fingerprints (min 16 chars, required in prod)
ADDRESS_HASH_KEY=

# --- M2b: recommendation engine ---
# Monday board API token (reads + the scoped status write)
MONDAY_API_TOKEN=
# Monday webhook signing secret (verifies the signed Authorization JWT)
MONDAY_WEBHOOK_SIGNING_SECRET=
# Google Maps key with the Routes API enabled + allowed on the key
GOOGLE_MAPS_API_KEY=
# OpenRouter key for the address-cleanup LLM
OPENROUTER_API_KEY=
# Shared secret for the Vercel cron drain (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# --- optional tuning ---
# Max snapshot age before a run FOUTs as stale_snapshot (default 48)
SNAPSHOT_MAX_AGE_HOURS=
# Override the Inplannen group id (defaults to the value in board-config)
MONDAY_INPLANNEN_GROUP_ID=