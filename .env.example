NODE_ENV=development

# Logging — LOG_ENABLED must be true in production, the logger defaults to OFF there
LOG_ENABLED=true
LOG_LEVEL=info

# --- Monday ---
# Board API token (reads + the scoped status write)
MONDAY_API_TOKEN=
# Shared secret in the webhook URL: .../api/webhooks/monday/recommendations?token=THIS
MONDAY_WEBHOOK_TOKEN=
# OUR status column on Agenda 2026. Must NOT be color_mkzwfy42 — that one is n8n's
MONDAY_RECOMMENDATION_STATUS_COLUMN=
# Override the Inplannen group id (defaults to the value in board-config)
MONDAY_TRIGGER_GROUP_IDS=

# --- Upstash Redis (job state + caches only, never a system of record) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (the durable job queue) ---
QSTASH_TOKEN=
# Both signing keys are required — the receiver accepts either, so rotation is safe
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Routes back into this app ---
# No trailing slash. Falls back to VERCEL_URL in production; required locally
PUBLIC_BASE_URL=
# Vercel Cron sends this as Authorization: Bearer. Unset ⇒ the sweep rejects everything,
# which silently disables lost-trigger recovery
CRON_SECRET=
# Bearer for GET /api/config/trainer-groups
CONFIG_API_SECRET=

# --- Providers ---
# Google Maps key with the Routes API enabled + allowed on the key
GOOGLE_MAPS_API_KEY=
# OpenRouter key for the address-cleanup LLM
OPENROUTER_API_KEY=
# HMAC secret for keyed travel-cache keys & audit fingerprints (min 16 chars, required in prod)
ADDRESS_HASH_KEY=

# --- Engine config — INTERIM, MOVES TO THE MONDAY INSTELLINGEN BOARD ---
# These belong to ITG, not to us. Living here means every rate change needs a
# developer and a redeploy. See docs/m2b/README.md §10.
#
# REQUIRED in production — buildAppConfig throws rather than defaulting money values.
# Values below are the fase-1 numbers; confirm with ITG.
TRAVEL_RATE_TRAINER_CENTS_PER_KM=23
TRAVEL_RATE_CLIENT_CENTS_PER_KM=45
TRAVEL_TIME_FEE_PER_MINUTE_CENTS=100

# Optional overrides — LEAVE THESE COMMENTED OUT.
# A blank is NOT "absent": configRowsFromEnv forwards it as "" and the schema rejects
# it, so an uncommented blank stops the app at startup. Commented = absent = defaults.
#HQ_ADRES=
#THRESHOLD_HOURS=
#TRAVEL_TIME_THRESHOLD_MINUTES=
#TRAVEL_TIME_MODE=
# Comma-separated Monday group ids. Absent ⇒ GROUP_POLICY default.
#RECOMMENDABLE_TRAINER_GROUPS=
